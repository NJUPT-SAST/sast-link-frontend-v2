# API 基地址，两种模式：
#   /v2                 → 走 next.config.ts 的 dev rewrite 代理到生产后端（同源，
#                         新 tab cookie 会话 / OAuth 授权流可用，推荐）
#   http://localhost:8080 → 直连本地后端（跨域；cookie 会话特性不可用——新 tab
#                          bootstrap 会 401，已登录跨 tab 仍会要求重新登录）
NEXT_PUBLIC_API_BASE_URL=/v2
# 开启后由 MSW 提供 mock 数据，无需后端（测试/无后端开发用）。
# 注意：MSW 不种真实 httpOnly cookie，mock 下 cookie 会话特性同样无法演示。
NEXT_PUBLIC_API_MOCKING=true
# OAuth 绑定（值需与后端 OAUTH_* 配置一致）
NEXT_PUBLIC_FEISHU_CLIENT_ID=
NEXT_PUBLIC_FEISHU_BIND_REDIRECT_URI=http://localhost:3000/oauth/bind/lark
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_BIND_REDIRECT_URI=http://localhost:3000/oauth/bind/github
